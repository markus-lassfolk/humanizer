{
  "name": "humanizer",
  "version": "2.6.0",
  "description": "OpenClaw AI Humanizer - detect and remove AI writing patterns. Scans text for 36 detectors (English), with statistical analysis (burstiness, TTR, readability) and optional n-gram LM uniformity (--with-lm). Provides actionable suggestions to sound natural and human.",
  "main": "src/analyzer.js",
  "bin": {
    "humanizer": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ locales/",
    "lint:fix": "eslint src/ tests/ locales/ --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js' 'locales/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'tests/**/*.js' 'locales/**/*.js'",
    "check:lint": "npm run lint && npm run format:check",
    "check:locale": "npm run locale:prescriptive -- --check && npm run locale:prescriptive-en -- --check && npm run validate:sv-tiers && npm run validate:en-tiers",
    "check:test": "npm test",
    "check": "npm run check:lint && npm run check:locale && npm run check:test",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "locale:prescriptive": "node locales/sv-se/scripts/build-sv-locale-prescriptive.mjs",
    "locale:prescriptive-en": "node locales/en-en/scripts/build-en-locale-prescriptive.mjs",
    "validate:en-tiers": "node locales/en-en/scripts/validate-en-tiers.mjs",
    "freq:baseline-en": "node locales/en-en/scripts/build-en-frequency-baseline.mjs",
    "corpus:seed-en": "node locales/en-en/scripts/seed-en-corpus.mjs",
    "corpus:logodds-en": "node locales/en-en/scripts/log-odds-en.mjs",
    "corpus:calibrate-en": "node locales/en-en/scripts/calibration-report-en.mjs",
    "corpus:llm-en": "node locales/en-en/scripts/generate-en-llm-corpus.mjs",
    "en:pipeline": "node locales/en-en/scripts/en-pipeline.mjs",
    "validate:sv-tiers": "node locales/sv-se/scripts/validate-sv-tiers.mjs",
    "freq:baseline": "node locales/sv-se/scripts/build-sv-frequency-baseline.mjs",
    "materialize:baseline-corpus": "node locales/sv-se/scripts/materialize-baseline-corpus.mjs",
    "corpus:seed": "node locales/sv-se/scripts/seed-sv-corpus.mjs",
    "corpus:build": "node locales/sv-se/scripts/build-corpus-extended.mjs",
    "corpus:logodds": "node locales/sv-se/scripts/log-odds.mjs",
    "corpus:calibrate": "node locales/sv-se/scripts/calibration-report.mjs",
    "corpus:llm": "node locales/sv-se/scripts/generate-sv-llm-corpus.mjs",
    "corpus:refresh": "node locales/sv-se/scripts/seed-sv-corpus.mjs && node locales/sv-se/scripts/log-odds.mjs && node locales/sv-se/scripts/calibration-report.mjs",
    "sv:pipeline": "node locales/sv-se/scripts/sv-pipeline.mjs",
    "sv:pipeline:lm": "node locales/sv-se/scripts/sv-pipeline.mjs --with-lm",
    "lm:build-sv": "node locales/sv-se/scripts/build-sv-ngram-lm.mjs",
    "prompts:seed-en": "node locales/en-en/scripts/seed-en-prompts.mjs",
    "materialize:baseline-corpus-en": "node locales/en-en/scripts/materialize-baseline-corpus-en.mjs",
    "corpus:refresh-en": "node locales/en-en/scripts/seed-en-corpus.mjs && node locales/en-en/scripts/log-odds-en.mjs && node locales/en-en/scripts/calibration-report-en.mjs",
    "en:ml:dataset": "node locales/en-en/scripts/build-en-ml-dataset.mjs",
    "en:ml:train": "node locales/en-en/scripts/train-en-calibrator.mjs",
    "en:wiki:sample": "node locales/en-en/scripts/fetch-enwiki-human-sample.mjs",
    "prompts:seed": "node locales/sv-se/scripts/seed-sv-prompts.mjs",
    "tune:scoring": "node scripts/tune-scoring.mjs",
    "tune:scoring:quick": "node scripts/tune-scoring.mjs --quick",
    "tune:scoring:windows": "node scripts/tune-scoring.mjs --windows",
    "build": "echo 'No build step needed — pure Node.js'"
  },
  "keywords": [
    "ai",
    "writing",
    "humanize",
    "llm",
    "detection",
    "text-analysis",
    "openclaw",
    "skill",
    "burstiness",
    "type-token-ratio",
    "flesch-kincaid",
    "ai-detection"
  ],
  "author": "Brandon Wise",
  "contributors": [
    "Markus Lassfolk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markus-lassfolk/humanizer"
  },
  "homepage": "https://github.com/markus-lassfolk/humanizer#readme",
  "bugs": {
    "url": "https://github.com/markus-lassfolk/humanizer/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "locales",
    "reports",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ]
}
